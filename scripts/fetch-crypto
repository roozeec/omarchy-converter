#!/usr/bin/bash
# Fetch crypto spot prices (USD per coin) from CoinGecko, with a disk cache.
# Prints one JSON line: {ok, fetched_at, prices: {<id>: {usd: ...}, ...}}.
# Usage: fetch-crypto <id,id,...> [--force]
#
# Hardened:
# - absolute executable paths; bounded reads (timeout) and bounded sizes
# - refuses to run if this helper is not owned by the invoking user or is
#   group/other-writable
# - every component of the cache directory chain below $HOME must be a real
#   directory (no symlinks), owned by this user or root, and not
#   group/other-writable
# - all file access happens through a retained directory FD (/proc/self/fd),
#   so parent-directory swaps cannot redirect the leaf after validation
# - the cache leaf must be a plain, owned, < 256 KiB regular file; writes go
#   through a private temp file replaced with rename(2), which never follows
#   a planted symlink
# - emitted schema is capped (<= 50 coins, numeric usd only) and input ids
#   are validated and length-capped
# Residual risk: an attacker already running as this user can replace the
# helper or plugin files themselves; leaf swaps inside the anchored
# directory between stat and open remain theoretically possible in bash.

set -euo pipefail

CURL=/usr/bin/curl
JQ=/usr/bin/jq
MKTEMP=/usr/bin/mktemp
MKDIR=/usr/bin/mkdir
DATE=/usr/bin/date
CAT=/usr/bin/cat
RM=/usr/bin/rm
CHMOD=/usr/bin/chmod
FIND=/usr/bin/find
MV=/usr/bin/mv
ID=/usr/bin/id
STAT=/usr/bin/stat
TIMEOUT=/usr/bin/timeout

# Refuse to run if someone else could have modified this helper: it must be
# owned by the invoking user and not group- or other-writable.
[[ -O $0 ]] || exit 1
__mode=$($STAT -c '%a' "$0" 2>/dev/null) || exit 1
if ((( 8#$__mode & 8#022 ) != 0)); then
  exit 1
fi

ids=${1:-}
if [[ ! $ids =~ ^[a-z0-9-]+(,[a-z0-9-]+)*$ ]] || ((${#ids} > 400)); then
  printf '%s\n' '{"ok":false,"error":"invalid ids"}'
  exit 1
fi

force=false
if [[ ${2:-} == "--force" ]]; then
  force=true
fi

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/converter"
cache_dir=${cache_dir%/}
cache_file="$cache_dir/crypto.json"
ttl_seconds=$((10 * 60))

chain_ok() {
  local acc="" part owner mode
  # Split on "/" via parameter expansion; do NOT touch IFS here — it would
  # shred every unquoted expansion below (e.g. $STAT -> "usr bin stat").
  for part in ${cache_dir//\// }; do
    [[ -n $part ]] || continue
    acc="$acc/$part"
    [[ -e $acc ]] || continue
    if [[ $acc != "$HOME" ]]; then
      [[ -L $acc ]] && return 1
    fi
    owner=$($STAT -c '%u' "$acc") || return 1
    [[ $owner == "$($ID -u)" || $owner == 0 ]] || return 1
    mode=$($STAT -c '%a' "$acc") || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
  done
  return 0
}

unsafe() {
  printf '%s\n' '{"ok":false,"error":"unsafe cache directory"}'
  exit 1
}

chain_ok || unsafe
$MKDIR -p "$cache_dir"
$CHMOD 700 "$cache_dir"
chain_ok || unsafe

exec {cfd}<"$cache_dir"
anchored() { printf '%s' "/proc/self/fd/$cfd/$1"; }

leaf=$(anchored "crypto.json")

cache_usable() {
  [[ -e $leaf ]] || return 1
  [[ -n $(
    $FIND "$leaf" -maxdepth 0 -type f -size -256k -user "$($ID -u)" 2>/dev/null
  ) ]]
}

if cache_usable; then
  fetched=$($TIMEOUT 3 $JQ -r '.fetched_at // 0 | floor' "$leaf" 2>/dev/null || echo 0)
  now=$($DATE +%s)
  if ! $force && ((now - fetched < ttl_seconds)); then
    $TIMEOUT 3 $CAT "$leaf"
    exit 0
  fi
fi

tmp=$($MKTEMP "$(anchored '.crypto.XXXXXX')")
trap '$RM -f "$tmp" "$tmp.out"' EXIT
encoded=$($JQ -rn --arg v "$ids" '$v | @uri')
if $CURL --fail --silent --show-error --connect-timeout 4 --max-time 10 \
    --max-filesize 1048576 --proto '=https' \
    --user-agent 'roozeec.omarchy-converter/1.2' \
    "https://api.coingecko.com/api/v3/simple/price?ids=$encoded&vs_currencies=usd" -o "$tmp" \
   && $TIMEOUT 5 $JQ -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
  # Producer-side caps: at most 50 coins, each reduced to a numeric usd.
  if $TIMEOUT 5 $JQ -c '{ok: true, fetched_at: (now | floor), prices: (
        to_entries
        | map(select(
            (.value | type == "object") and (.value.usd | type == "number")
          ))
        | .[:50]
        | map({key: .key, value: {usd: .value.usd}})
        | from_entries
      )}' "$tmp" > "$tmp.out" \
     && [[ -s $tmp.out ]] \
     && $TIMEOUT 3 $JQ -e '.ok == true and (.prices | type == "object")' "$tmp.out" >/dev/null 2>&1; then
    $MV -f "$tmp.out" "$leaf" # rename(2): atomic, replaces any symlink
    $TIMEOUT 3 $CAT "$leaf"
    exit 0
  fi
fi

# A stale cache beats no data.
if cache_usable; then
  $TIMEOUT 3 $CAT "$leaf"
  exit 0
fi

printf '%s\n' '{"ok":false,"error":"unavailable"}'
exit 1
