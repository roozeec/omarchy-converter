#!/usr/bin/bash
# Fetch fiat exchange rates (currency units per 1 USD) from open.er-api.com,
# with a disk cache. Prints one JSON line: {ok, base, fetched_at, rates}.
# Usage: fetch-rates [BASE] [--force]
#
# Hardened:
# - absolute executable paths; bounded reads (timeout) and bounded sizes
# - refuses to run if this helper is not owned by the invoking user or is
#   group/other-writable
# - every component of the cache directory chain below $HOME must be a real
#   directory (no symlinks), owned by this user or root, and not
#   group/other-writable
# - all file access happens through a retained directory FD (/proc/self/fd),
#   so parent-directory swaps cannot redirect the leaf after validation
# - the cache leaf must be a plain, owned, < 2 MiB regular file; writes go
#   through a private temp file replaced with rename(2), which never follows
#   a planted symlink
# - emitted schema is capped (3-letter codes, numeric values, <= 300
#   entries) so QML parses and retains a bounded object
# Residual risk: an attacker already running as this user can replace the
# helper or plugin files themselves; leaf swaps inside the anchored
# directory between stat and open remain theoretically possible in bash.

set -euo pipefail

CURL=/usr/bin/curl
JQ=/usr/bin/jq
MKTEMP=/usr/bin/mktemp
MKDIR=/usr/bin/mkdir
DATE=/usr/bin/date
CAT=/usr/bin/cat
RM=/usr/bin/rm
CHMOD=/usr/bin/chmod
FIND=/usr/bin/find
MV=/usr/bin/mv
TR=/usr/bin/tr
ID=/usr/bin/id
STAT=/usr/bin/stat
TIMEOUT=/usr/bin/timeout

# Refuse to run if someone else could have modified this helper: it must be
# owned by the invoking user and not group- or other-writable.
[[ -O $0 ]] || exit 1
__mode=$($STAT -c '%a' "$0" 2>/dev/null) || exit 1
if ((( 8#$__mode & 8#022 ) != 0)); then
  exit 1
fi

base=$($TR '[:lower:]' '[:upper:]' <<< "${1:-USD}")
if [[ ! $base =~ ^[A-Z]{3}$ ]]; then
  printf '%s\n' '{"ok":false,"error":"invalid base"}'
  exit 1
fi

force=false
if [[ ${2:-} == "--force" ]]; then
  force=true
fi

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/converter"
cache_dir=${cache_dir%/}
cache_file="$cache_dir/rates-$base.json"
ttl_seconds=$((6 * 60 * 60))

# Every existing component below $HOME: no symlinks, owned by this user or
# root, not group/other-writable. $HOME itself may be a symlink.
chain_ok() {
  local acc="" part owner mode
  # Split on "/" via parameter expansion; do NOT touch IFS here — it would
  # shred every unquoted expansion below (e.g. $STAT -> "usr bin stat").
  for part in ${cache_dir//\// }; do
    [[ -n $part ]] || continue
    acc="$acc/$part"
    [[ -e $acc ]] || continue
    if [[ $acc != "$HOME" ]]; then
      [[ -L $acc ]] && return 1
    fi
    owner=$($STAT -c '%u' "$acc") || return 1
    [[ $owner == "$($ID -u)" || $owner == 0 ]] || return 1
    mode=$($STAT -c '%a' "$acc") || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
  done
  return 0
}

unsafe() {
  printf '%s\n' '{"ok":false,"error":"unsafe cache directory"}'
  exit 1
}

chain_ok || unsafe
$MKDIR -p "$cache_dir"
$CHMOD 700 "$cache_dir"
chain_ok || unsafe

# Anchor the directory: everything below goes through this FD, so later
# swaps of the path's parent components cannot redirect the leaf.
exec {cfd}<"$cache_dir"
anchored() { printf '%s' "/proc/self/fd/$cfd/$1"; }

leaf=$(anchored "rates-$base.json")

cache_usable() {
  [[ -e $leaf ]] || return 1
  [[ -n $(
    $FIND "$leaf" -maxdepth 0 -type f -size -2M -user "$($ID -u)" 2>/dev/null
  ) ]]
}

if cache_usable; then
  fetched=$($TIMEOUT 3 $JQ -r '.fetched_at // 0 | floor' "$leaf" 2>/dev/null || echo 0)
  now=$($DATE +%s)
  if ! $force && ((now - fetched < ttl_seconds)); then
    $TIMEOUT 3 $CAT "$leaf"
    exit 0
  fi
fi

tmp=$($MKTEMP "$(anchored '.rates.XXXXXX')")
trap '$RM -f "$tmp" "$tmp.out"' EXIT
if $CURL --fail --silent --show-error --connect-timeout 4 --max-time 10 \
    --max-filesize 4194304 --proto '=https' \
    --user-agent 'roozeec.omarchy-converter/1.2' \
    "https://open.er-api.com/v6/latest/$base" -o "$tmp" \
   && $TIMEOUT 5 $JQ -e '.result == "success" and (.rates | type == "object")' "$tmp" >/dev/null 2>&1; then
  # Producer-side caps: only 3-letter uppercase codes mapping to numbers,
  # at most 300 entries.
  if $TIMEOUT 5 $JQ -c '{ok: true, base: .base_code, fetched_at: (now | floor), rates: (
        .rates | to_entries
        | map(select((.key | test("^[A-Z]{3}$")) and (.value | type == "number")))
        | .[:300]
        | from_entries
      )}' "$tmp" > "$tmp.out" \
     && [[ -s $tmp.out ]] \
     && $TIMEOUT 3 $JQ -e '.ok == true and (.rates | type == "object")' "$tmp.out" >/dev/null 2>&1; then
    $MV -f "$tmp.out" "$leaf" # rename(2): atomic, replaces any symlink
    $TIMEOUT 3 $CAT "$leaf"
    exit 0
  fi
fi

# A stale cache beats no data.
if cache_usable; then
  $TIMEOUT 3 $CAT "$leaf"
  exit 0
fi

printf '%s\n' '{"ok":false,"error":"unavailable"}'
exit 1
